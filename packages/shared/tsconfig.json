{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true, "strict": true, "noUncheckedIndexedAccess": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": [], "declaration": true,
    "rootDir": "src", "outDir": "dist", "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}

