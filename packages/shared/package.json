{
  "name": "@folk-tag/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./movement": {
      "types": "./dist/movement.d.ts",
      "import": "./dist/movement.js",
      "default": "./dist/movement.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "default": "./dist/rules.js"
    },
    "./collision": {
      "types": "./dist/collision.d.ts",
      "import": "./dist/collision.js",
      "default": "./dist/collision.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js",
      "default": "./dist/map.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js",
      "default": "./dist/hash.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "default": "./dist/capture.js"
    },
    "./rescue": {
      "types": "./dist/rescue.d.ts",
      "import": "./dist/rescue.js",
      "default": "./dist/rescue.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "import": "./dist/guard.js",
      "default": "./dist/guard.js"
    },
    "./stealth": {
      "types": "./dist/stealth.d.ts",
      "import": "./dist/stealth.js",
      "default": "./dist/stealth.js"
    },
    "./maps/*": "./maps/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "6.0.3"
  }
}
